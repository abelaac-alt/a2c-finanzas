<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" style="@style/Widget.A2C.Root"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView style="@style/Widget.A2C.Title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/widget_stocks" />
        <TextView android:id="@+id/stocks_status" style="@style/Widget.A2C.Small" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>
    <TextView android:id="@+id/stocks_empty" style="@style/Widget.A2C.Small" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/widget_stocks_empty" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="vertical">
        <LinearLayout android:id="@+id/stock_row_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="5dp" android:paddingBottom="5dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/stock_symbol_1" style="@style/Widget.A2C.Strong" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/stock_name_1" style="@style/Widget.A2C.Small" android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
                <TextView android:id="@+id/stock_price_1" style="@style/Widget.A2C.Strong" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/stock_change_1" style="@style/Widget.A2C.Change" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/stock_row_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="5dp" android:paddingBottom="5dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/stock_symbol_2" style="@style/Widget.A2C.Strong" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/stock_name_2" style="@style/Widget.A2C.Small" android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
                <TextView android:id="@+id/stock_price_2" style="@style/Widget.A2C.Strong" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/stock_change_2" style="@style/Widget.A2C.Change" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/stock_row_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="5dp" android:paddingBottom="5dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/stock_symbol_3" style="@style/Widget.A2C.Strong" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/stock_name_3" style="@style/Widget.A2C.Small" android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
                <TextView android:id="@+id/stock_price_3" style="@style/Widget.A2C.Strong" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/stock_change_3" style="@style/Widget.A2C.Change" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/stock_row_4" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="5dp" android:paddingBottom="5dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/stock_symbol_4" style="@style/Widget.A2C.Strong" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/stock_name_4" style="@style/Widget.A2C.Small" android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
                <TextView android:id="@+id/stock_price_4" style="@style/Widget.A2C.Strong" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/stock_change_4" style="@style/Widget.A2C.Change" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/stock_row_5" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="5dp" android:paddingBottom="5dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/stock_symbol_5" style="@style/Widget.A2C.Strong" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/stock_name_5" style="@style/Widget.A2C.Small" android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
                <TextView android:id="@+id/stock_price_5" style="@style/Widget.A2C.Strong" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/stock_change_5" style="@style/Widget.A2C.Change" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/stock_row_6" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="5dp" android:paddingBottom="5dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/stock_symbol_6" style="@style/Widget.A2C.Strong" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/stock_name_6" style="@style/Widget.A2C.Small" android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
                <TextView android:id="@+id/stock_price_6" style="@style/Widget.A2C.Strong" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/stock_change_6" style="@style/Widget.A2C.Change" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>